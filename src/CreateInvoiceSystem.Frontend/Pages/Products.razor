@page "/products"
@using CreateInvoiceSystem.Frontend.Models
@using CreateInvoiceSystem.Frontend.Services
@using CreateInvoiceSystem.Frontend.Components
@using System.Globalization
@inject ProductService ProductService

<div class="container-fluid">
    <h3 class="mb-4">Zarządzanie Produktami</h3>

    @if (!string.IsNullOrEmpty(_pageErrorMessage))
    {
        <div class="alert @(_pageErrorIsError ? "alert-danger" : "alert-info")">
            @_pageErrorMessage
        </div>
    }

    <div class="row mb-4 align-items-end">
        <div class="col-md-6">
            <label class="form-label small fw-bold">Wyszukaj produkt</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text"
                       class="form-control border-start-0"
                       placeholder="Wpisz nazwę lub opis..."
                       @bind="_searchTerm"
                       @bind:event="oninput"
                       @onkeyup="HandleSearch" />
                @if (!string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <button class="btn btn-outline-secondary border-start-0" @onclick="ClearSearch">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
        </div>

        <div class="col-md-6 text-end">
            <button class="btn btn-outline-secondary me-2" @onclick="ExportToCsv">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Eksportuj CSV
            </button>
            <button class="btn btn-primary" @onclick="OpenAddModal">
                <i class="bi bi-plus-circle me-1"></i> Dodaj produkt
            </button>
        </div>
    </div>

    @if (_isModalOpen)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog shadow-lg">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">Dodaj Nowy Produkt</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(_modalErrorMessage))
                        {
                            <div class="alert alert-danger small">@_modalErrorMessage</div>
                        }
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Nazwa produktu</label>
                            <SimpleTextInput Value="@_newName"
                                             ValueChanged="v => { _newName = v ?? string.Empty; Touch(_modalTouched, nameof(_newName)); }"
                                             IsActive="@IsActive(_modalTouched, _modalSubmitAttempted, nameof(_newName))"
                                             Placeholder="np. Kawa" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Opis</label>
                            <textarea class="form-control"
                                      placeholder="Opcjonalny opis..."
                                      @oninput="e => _newDescription = e.Value?.ToString() ?? string.Empty">@_newDescription</textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Cena</label>
                            <SimpleDecimalInput Value="@_newValue"
                                                ValueChanged="v => { _newValue = v; Touch(_modalTouched, nameof(_newValue)); }"
                                                StringValue="@_newValueString"
                                                StringValueChanged="s => _newValueString = s"
                                                IsActive="@IsActive(_modalTouched, _modalSubmitAttempted, nameof(_newValue))"
                                                ErrorMessage="Podaj prawidłową cenę" />
                            <div class="mt-1"><small class="text-muted">PLN</small></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Anuluj</button>
                        <button type="button" class="btn btn-success px-4" @onclick="HandleSave">Zapisz produkt</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-light">Twoja lista produktów</div>
        <div class="card-body p-0">
            <DataTable Items="_products" Cols="4" TableClass="table table-hover mb-0" HeaderClass="table-dark" KeySelector="p => p.ProductId" NoItemsMessage="Brak produktów w bazie.">
                <HeaderTemplate>
                    <tr>
                        <th style="width: 25%">Nazwa</th>
                        <th style="width: 40%">Opis</th>
                        <th style="width: 15%" class="text-end">Cena</th>
                        <th style="width: 20%" class="text-center">Akcje</th>
                    </tr>
                </HeaderTemplate>

                <RowTemplate Context="p">
                    @if (_editingProductId == p.ProductId)
                    {
                        <td colspan="4" class="p-2">
                            <div class="editing-grid">
                                <div>
                                    <SimpleTextInput Value="@_editName"
                                                     ValueChanged="v => { _editName = v ?? string.Empty; Touch(_editTouched, nameof(_editName)); }"
                                                     IsActive="@IsActive(_editTouched, _editSubmitAttempted, nameof(_editName))"
                                                     Placeholder="Nazwa" />
                                </div>
                                <div>
                                    <input type="text" class="form-control" placeholder="Opis" value="@_editDescription"
                                           @oninput="e => _editDescription = e.Value?.ToString() ?? string.Empty" />
                                </div>
                                <div class="text-end">
                                    <SimpleDecimalInput Value="@_editValue"
                                                        ValueChanged="v => { _editValue = v; Touch(_editTouched, nameof(_editValue)); }"
                                                        StringValue="@_editValueString"
                                                        StringValueChanged="s => _editValueString = s"
                                                        IsActive="@IsActive(_editTouched, _editSubmitAttempted, nameof(_editValue))"
                                                        ErrorMessage="Podaj prawidłową cenę" />
                                </div>
                                <div class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <button type="button" class="btn btn-sm btn-success px-3 shadow-sm" @onclick="SubmitInlineEdit">
                                            <i class="bi bi-check-lg"></i> Zapisz
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" @onclick="CancelEdit">
                                            Anuluj
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </td>
                    }
                    else
                    {
                        <td class="align-middle"><strong>@p.Name</strong></td>
                        <td class="align-middle text-truncate" style="max-width: 300px;">@p.Description</td>
                        <td class="align-middle text-end">@p.Value?.ToString("N2") PLN</td>
                        <td class="text-center align-middle">
                            <div class="d-flex justify-content-center gap-2">
                                <button class="btn btn-sm btn-primary px-3 shadow-sm" @onclick="() => StartEdit(p)">
                                    <i class="bi bi-pencil-square me-1"></i> Edytuj
                                </button>
                                <button class="btn btn-sm btn-danger px-3 shadow-sm" @onclick="() => HandleDelete(p.ProductId)">
                                    <i class="bi bi-trash me-1"></i> Usuń
                                </button>
                            </div>
                        </td>
                    }
                </RowTemplate>
            </DataTable>
        </div>
    </div>
</div>

<style>
    .tiny {
        font-size: 0.75rem;
    }

    .editing-grid {
        display: grid;
        grid-template-columns: 25% 40% 15% 20%;
        gap: 8px;
        align-items: center;
    }

        .editing-grid .form-control {
            height: calc(1.5em + 0.5rem);
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

    .editing-row td {
        vertical-align: middle;
    }
</style>

<Pagination ItemsOnPageCount="@(_products?.Count ?? 0)"
            TotalItems="@_totalCount"
            CurrentPage="@_currentPage"
            CurrentPageChanged="ChangePage"
            PageSize="@_pageSize"
            PageSizeChanged="ChangePageSize"
            ItemLabel="produktów" />

@code {
    private List<ProductDto>? _products;
    private int? _editingProductId;

    // modal "dodaj produkt"
    private string _newName = string.Empty;
    private string _newDescription = string.Empty;
    private decimal? _newValue;
    private string _newValueString = string.Empty;
    private HashSet<string> _modalTouched = new();
    private bool _modalSubmitAttempted;

    // edycja wiersza w tabeli
    private string _editName = string.Empty;
    private string _editDescription = string.Empty;
    private decimal? _editValue;
    private string _editValueString = string.Empty;
    private int _editProductId;
    private HashSet<string> _editTouched = new();
    private bool _editSubmitAttempted;

    private int _pageSize = 10;
    private int _currentPage = 1;
    private int _totalCount = 0;
    private int _totalPages => (int)Math.Ceiling((double)_totalCount / _pageSize);
    private string _searchTerm = "";
    private System.Timers.Timer? _searchTimer;
    private bool _isModalOpen = false;

    private string? _pageErrorMessage;
    private bool _pageErrorIsError;
    private string? _modalErrorMessage;

    private void Touch(HashSet<string> touched, string field) => touched.Add(field);
    private bool IsActive(HashSet<string> touched, bool submitAttempted, string field) => submitAttempted || touched.Contains(field);

    private void OpenAddModal()
    {
        _modalTouched.Clear();
        _modalSubmitAttempted = false;
        _newName = string.Empty;
        _newDescription = string.Empty;
        _newValue = null;
        _newValueString = string.Empty;
        _modalErrorMessage = null;
        _isModalOpen = true;
    }

    private void CloseModal()
    {
        _isModalOpen = false;
        _modalErrorMessage = null;
    }

    private async Task LoadData()
    {
        var response = await ProductService.GetProductsAsync(_currentPage, _pageSize, _searchTerm);
        _products = response.Data;
        _totalCount = response.TotalCount;
        _pageErrorMessage = null;
        _pageErrorIsError = false;
        StateHasChanged();
    }

    private async Task HandleSave()
    {
        _modalSubmitAttempted = true;

        if (string.IsNullOrWhiteSpace(_newName) || _newValue == null || _newValue <= 0)
        {
            _modalErrorMessage = "Uzupełnij poprawnie nazwę i cenę.";
            StateHasChanged();
            return;
        }

        try
        {
            var product = new ProductDto
            {
                Name = _newName,
                Description = _newDescription,
                Value = _newValue
            };

            await ProductService.SaveProductAsync(product);
            _isModalOpen = false;
            _modalErrorMessage = null;
            await LoadData();
        }
        catch (ApiException aex)
        {
            var userMessage = aex.GetUserMessage();
            var msg = string.IsNullOrWhiteSpace(userMessage) ? "Wystąpił błąd podczas zapisu produktu." : userMessage;
            if (!msg.StartsWith("Błąd")) msg = "Błąd: " + msg;
            _modalErrorMessage = msg;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            var sanitized = ApiExceptionExtensions.SanitizeMessage(ex.Message);
            if (!sanitized.StartsWith("Błąd")) sanitized = "Błąd: " + sanitized;
            _modalErrorMessage = sanitized;
            StateHasChanged();
        }
    }

    private void HandleSearch()
    {
        _searchTimer?.Stop();
        _searchTimer?.Dispose();
        _searchTimer = new System.Timers.Timer(400);
        _searchTimer.Elapsed += async (s, e) =>
        {
            _searchTimer.Stop();
            _currentPage = 1;
            await InvokeAsync(LoadData);
        };
        _searchTimer.Start();
    }

    private async Task ClearSearch() { _searchTerm = ""; _currentPage = 1; await LoadData(); }
    private async Task ChangePage(int newPage) { if (newPage < 1) newPage = 1; _currentPage = newPage; await LoadData(); }

    private async Task ChangePageSize(int newSize)
    {
        if (newSize <= 0) return;
        _pageSize = newSize;
        _currentPage = 1;
        await LoadData();
    }

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task HandleDelete(int productId)
    {
        try
        {
            await ProductService.DeleteProductAsync(productId);
            await LoadData();
        }
        catch (ApiException aex)
        {
            var userMessage = aex.GetUserMessage();
            var msg = string.IsNullOrWhiteSpace(userMessage) ? "Wystąpił błąd podczas usuwania produktu." : userMessage;
            if (!msg.StartsWith("Błąd")) msg = "Błąd: " + msg;
            _pageErrorMessage = msg;
            _pageErrorIsError = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            var sanitized = ApiExceptionExtensions.SanitizeMessage(ex.Message);
            if (!sanitized.StartsWith("Błąd")) sanitized = "Błąd: " + sanitized;
            _pageErrorMessage = sanitized;
            _pageErrorIsError = true;
            StateHasChanged();
        }
    }

    private void StartEdit(ProductDto product)
    {
        _editingProductId = product.ProductId;
        _editProductId = product.ProductId;
        _editName = product.Name;
        _editDescription = product.Description;
        _editValue = product.Value;
        _editValueString = product.Value?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
        _editTouched.Clear();
        _editSubmitAttempted = false;

        _pageErrorMessage = null;
        _pageErrorIsError = false;
    }

    private void CancelEdit()
    {
        _editingProductId = null;
    }

    private async Task SubmitInlineEdit()
    {
        _editSubmitAttempted = true;

        if (string.IsNullOrWhiteSpace(_editName) || _editValue == null || _editValue <= 0)
        {
            _pageErrorMessage = "Uzupełnij poprawnie nazwę i cenę.";
            _pageErrorIsError = true;
            StateHasChanged();
            return;
        }

        var dto = new ProductDto
        {
            ProductId = _editProductId,
            Name = _editName,
            Description = _editDescription,
            Value = _editValue
        };

        try
        {
            await ProductService.UpdateProductAsync(dto);
            _editingProductId = null;
            _pageErrorMessage = null;
            await LoadData();
        }
        catch (ApiException aex)
        {
            var userMessage = aex.GetUserMessage();
            var msg = string.IsNullOrWhiteSpace(userMessage) ? "Wystąpił błąd podczas zapisu produktu." : userMessage;
            if (!msg.StartsWith("Błąd")) msg = "Błąd: " + msg;
            _pageErrorMessage = msg;
            _pageErrorIsError = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            var sanitized = ApiExceptionExtensions.SanitizeMessage(ex.Message);
            if (!sanitized.StartsWith("Błąd")) sanitized = "Błąd: " + sanitized;
            _pageErrorMessage = sanitized;
            _pageErrorIsError = true;
            StateHasChanged();
        }
    }

    private async Task ExportToCsv()
    {
        try
        {
            await ProductService.DownloadProductsCsvAsync();
        }
        catch (ApiException aex)
        {
            var userMessage = aex.GetUserMessage();
            var msg = string.IsNullOrWhiteSpace(userMessage) ? "Wystąpił błąd podczas eksportu produktów." : userMessage;
            if (!msg.StartsWith("Błąd")) msg = "Błąd: " + msg;
            _pageErrorMessage = msg;
            _pageErrorIsError = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            var sanitized = ApiExceptionExtensions.SanitizeMessage(ex.Message);
            if (!sanitized.StartsWith("Błąd")) sanitized = "Błąd: " + sanitized;
            _pageErrorMessage = sanitized;
            _pageErrorIsError = true;
            StateHasChanged();
        }
    }
}