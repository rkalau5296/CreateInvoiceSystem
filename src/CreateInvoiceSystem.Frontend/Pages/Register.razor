@page "/register"
@using System.Text.Json
@using CreateInvoiceSystem.Frontend.Models
@using CreateInvoiceSystem.Frontend.Components
@using CreateInvoiceSystem.Frontend.Services
@attribute [AllowAnonymous]
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white py-3">
                    <h3 class="mb-0">Rejestracja konta firmowego</h3>
                </div>
                <div class="card-body p-4">
                    @if (!_isRegistered)
                    {
                        <div class="row">
                            <div class="col-md-6 border-end">
                                <h5 class="text-primary mb-3">Dane użytkownika</h5>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Email / Login</label>
                                    <SimpleEmailInput Value="@_regModel.Email"
                                                      ValueChanged="v => { _regModel.Email = v ?? string.Empty; Touch(nameof(_regModel.Email)); }"
                                                      IsActive="@IsActive(nameof(_regModel.Email))"
                                                      Required="true"
                                                      Placeholder="Email / Login" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Hasło</label>
                                    <SimplePasswordInput Value="@_regModel.Password"
                                                         ValueChanged="v => { _regModel.Password = v ?? string.Empty; Touch(nameof(_regModel.Password)); }"
                                                         IsActive="@IsActive(nameof(_regModel.Password))"
                                                         MinLength="6"
                                                         RequireComplexity="true"
                                                         Placeholder="Hasło" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Potwierdź Hasło</label>
                                    <SimplePasswordInput Value="@_regModel.ConfirmPassword"
                                                         ValueChanged="v => { _regModel.ConfirmPassword = v ?? string.Empty; Touch(nameof(_regModel.ConfirmPassword)); }"
                                                         IsActive="@IsActive(nameof(_regModel.ConfirmPassword))"
                                                         MinLength="0"
                                                         CompareTo="@_regModel.Password"
                                                         Placeholder="Potwierdź Hasło" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Imię i Nazwisko</label>
                                    <SimpleTextInput Value="@_regModel.Name"
                                                     ValueChanged="v => { _regModel.Name = v ?? string.Empty; Touch(nameof(_regModel.Name)); }"
                                                     IsActive="@IsActive(nameof(_regModel.Name))"
                                                     Placeholder="Imię i Nazwisko" />
                                </div>

                                <h5 class="text-primary mt-4 mb-3">Dane firmy</h5>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Nazwa firmy</label>
                                    <SimpleTextInput Value="@_regModel.CompanyName"
                                                     ValueChanged="v => { _regModel.CompanyName = v ?? string.Empty; Touch(nameof(_regModel.CompanyName)); }"
                                                     IsActive="@IsActive(nameof(_regModel.CompanyName))"
                                                     Placeholder="Nazwa firmy" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">NIP</label>
                                    <SimpleNipInput Value="@_regModel.Nip"
                                                    ValueChanged="v => { _regModel.Nip = v ?? string.Empty; Touch(nameof(_regModel.Nip)); }"
                                                    IsActive="@IsActive(nameof(_regModel.Nip))"
                                                    Placeholder="NIP" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Konto bankowe</label>
                                    <SimpleIbanInput Value="@_regModel.BankAccountNumber"
                                                     ValueChanged="v => { _regModel.BankAccountNumber = v; Touch(nameof(_regModel.BankAccountNumber)); }"
                                                     IsActive="@IsActive(nameof(_regModel.BankAccountNumber))"
                                                     Placeholder="Konto bankowe" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">Adres siedziby</h5>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Ulica</label>
                                    <SimpleTextInput Value="@_regModel.Address.Street"
                                                     ValueChanged="v => { _regModel.Address.Street = v ?? string.Empty; Touch(nameof(_regModel.Address.Street)); }"
                                                     IsActive="@IsActive(nameof(_regModel.Address.Street))"
                                                     Placeholder="Ulica" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Numer budynku</label>
                                    <SimpleTextInput Value="@_regModel.Address.Number"
                                                     ValueChanged="v => { _regModel.Address.Number = v ?? string.Empty; Touch(nameof(_regModel.Address.Number)); }"
                                                     IsActive="@IsActive(nameof(_regModel.Address.Number))"
                                                     Placeholder="Numer budynku" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Kod pocztowy</label>
                                    <SimplePostalCodeInput Value="@_regModel.Address.PostalCode"
                                                           ValueChanged="v => { _regModel.Address.PostalCode = v ?? string.Empty; Touch(nameof(_regModel.Address.PostalCode)); }"
                                                           IsActive="@IsActive(nameof(_regModel.Address.PostalCode))"
                                                           Placeholder="Kod pocztowy" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Miasto</label>
                                    <SimpleTextInput Value="@_regModel.Address.City"
                                                     ValueChanged="v => { _regModel.Address.City = v ?? string.Empty; Touch(nameof(_regModel.Address.City)); }"
                                                     IsActive="@IsActive(nameof(_regModel.Address.City))"
                                                     Placeholder="Miasto" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Kraj</label>
                                    <SimpleTextInput Value="@_regModel.Address.Country"
                                                     ValueChanged="v => { _regModel.Address.Country = v ?? string.Empty; Touch(nameof(_regModel.Address.Country)); }"
                                                     IsActive="@IsActive(nameof(_regModel.Address.Country))"
                                                     Placeholder="Kraj" />
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        @if (!string.IsNullOrEmpty(statusMessage))
                        {
                            <div class="alert mb-3 @(isError ? "alert-danger" : "alert-success")">
                                @statusMessage
                            </div>
                        }

                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-primary btn-lg" disabled="@isSubmitting" @onclick="HandleRegister">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Trwa rejestracja...</span>
                                }
                                else
                                {
                                    <span>Zarejestruj konto</span>
                                }
                            </button>
                            <a href="/login" class="btn btn-link text-center">Powrót do logowania</a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-4">
                            <div class="mb-4">
                                <i class="bi bi-envelope-check text-success" style="font-size: 4rem;"></i>
                            </div>
                            <h3 class="text-success mb-3">Konto zostało utworzone!</h3>
                            <div class="alert alert-success shadow-sm">
                                <p class="mb-0">
                                    Jeśli podany adres e-mail jest prawidłowy, wysłaliśmy na niego <strong>link aktywacyjny</strong>.
                                    Prosimy o sprawdzenie skrzynki e-mail (oraz folderu Spam) i kliknięcie w link w celu aktywacji konta.
                                </p>
                            </div>
                            <div class="text-center mt-4">
                                <button type="button" class="btn btn-primary btn-lg w-100" @onclick='() => Navigation.NavigateTo("/")'>
                                    Przejdź do strony logowania
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterUserDto _regModel = new() { Address = new RegisterAddressDto() };
    private bool isSubmitting = false;
    private bool _isRegistered = false;
    private string statusMessage = "";
    private bool isError = false;
    private HashSet<string> _touched = new();
    private bool _submitAttempted;

    private static readonly System.Text.RegularExpressions.Regex PasswordComplexity =
        new(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).{6,}$");

    private void Touch(string field) => _touched.Add(field);
    private bool IsActive(string field) => _submitAttempted || _touched.Contains(field);

    private bool IsValid() =>
        !string.IsNullOrWhiteSpace(_regModel.Email) && EmailFormatHelper.IsValidOrEmpty(_regModel.Email) &&
        !string.IsNullOrWhiteSpace(_regModel.Password) && PasswordComplexity.IsMatch(_regModel.Password) &&
        _regModel.Password == _regModel.ConfirmPassword &&
        !string.IsNullOrWhiteSpace(_regModel.Name) &&
        !string.IsNullOrWhiteSpace(_regModel.CompanyName) &&
        System.Text.RegularExpressions.Regex.IsMatch(_regModel.Nip ?? "", @"^\d{10}$") &&
        System.Text.RegularExpressions.Regex.IsMatch(_regModel.BankAccountNumber ?? "", @"^PL\d{26}$") &&
        !string.IsNullOrWhiteSpace(_regModel.Address.Street) &&
        !string.IsNullOrWhiteSpace(_regModel.Address.Number) &&
        !string.IsNullOrWhiteSpace(_regModel.Address.City) &&
        System.Text.RegularExpressions.Regex.IsMatch(_regModel.Address.PostalCode ?? "", @"^\d{2}-\d{3}$") &&
        !string.IsNullOrWhiteSpace(_regModel.Address.Country);

    private async Task HandleRegister()
    {
        _submitAttempted = true;
        statusMessage = "";
        isError = false;

        if (!IsValid())
        {
            statusMessage = "Uzupełnij poprawnie wszystkie wymagane pola.";
            isError = true;
            return;
        }

        isSubmitting = true;

        try
        {
            var request = new RegisterUserRequest(_regModel);
            var result = await AuthService.RegisterAsync(request);

            if (result != null && result.Success)
            {
                _isRegistered = true;
                isError = false;
                return;
            }

            var svcMessage = result?.Message;
            var sanitized = string.IsNullOrWhiteSpace(svcMessage)
                ? "Wystąpił błąd podczas rejestracji."
                : ApiExceptionExtensions.SanitizeMessage(svcMessage);

            if (!sanitized.StartsWith("Błąd"))
                sanitized = "Błąd: " + sanitized;

            statusMessage = sanitized;
            isError = true;
        }
        catch (ApiException aex)
        {
            var userMessage = aex.GetUserMessage();
            if (!userMessage.StartsWith("Błąd"))
                userMessage = "Błąd: " + userMessage;

            statusMessage = userMessage;
            isError = true;

            if (!string.IsNullOrWhiteSpace(aex.Response))
            {
                try
                {
                    using var doc = JsonDocument.Parse(aex.Response);
                    if (doc.RootElement.TryGetProperty("errors", out var errorsElement) && errorsElement.ValueKind == JsonValueKind.Object)
                    {
                        var sb = new System.Text.StringBuilder();
                        foreach (var prop in errorsElement.EnumerateObject())
                        {
                            foreach (var msgElem in prop.Value.EnumerateArray())
                            {
                                var raw = msgElem.GetString();
                                if (!string.IsNullOrWhiteSpace(raw))
                                {
                                    var sanitizedMsg = ApiExceptionExtensions.SanitizeMessage(raw);
                                    if (!sanitizedMsg.StartsWith("Błąd"))
                                        sanitizedMsg = "Błąd: " + sanitizedMsg;
                                    if (sb.Length > 0) sb.Append(" ; ");
                                    sb.Append(sanitizedMsg);
                                }
                            }
                        }
                        if (sb.Length > 0)
                        {
                            statusMessage = sb.ToString();
                        }
                    }
                }
                catch
                {
                }
            }
        }
        catch (Exception ex)
        {
            var sanitizedEx = ApiExceptionExtensions.SanitizeMessage(ex.Message);
            if (!sanitizedEx.StartsWith("Błąd"))
                sanitizedEx = "Błąd: " + sanitizedEx;

            statusMessage = sanitizedEx;
            isError = true;
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}