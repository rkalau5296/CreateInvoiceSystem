@page "/settings"
@using System.Text.Json
@using CreateInvoiceSystem.Frontend.Components
@using CreateInvoiceSystem.Frontend.Models
@using CreateInvoiceSystem.Frontend.Services
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject UserService UserService
@inject NavigationManager Navigation

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-9">
            <h3 class="mb-4">Ustawienia Konta i Firmy</h3>

            @if (userModel == null)
            {
                <div class="d-flex align-items-center">
                    <div class="spinner-border me-2" role="status"></div>
                    <span>Ładowanie Twoich ustawień...</span>
                </div>
            }
            else
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Dane profilu i firmy</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Imię i Nazwisko</label>
                                <SimpleTextInput Value="@userModel.Name"
                                                 ValueChanged="v => { userModel.Name = v ?? string.Empty; Touch(nameof(userModel.Name)); }"
                                                 IsActive="@IsActive(nameof(userModel.Name))"
                                                 Placeholder="Wpisz imię i nazwisko" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Pełna Nazwa Firmy</label>
                                <SimpleTextInput Value="@userModel.CompanyName"
                                                 ValueChanged="v => { userModel.CompanyName = v ?? string.Empty; Touch(nameof(userModel.CompanyName)); }"
                                                 IsActive="@IsActive(nameof(userModel.CompanyName))"
                                                 Placeholder="Wpisz nazwę firmy" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Email</label>
                                <SimpleEmailInput Value="@userModel.Email"
                                                  ValueChanged="v => { userModel.Email = v ?? string.Empty; Touch(nameof(userModel.Email)); }"
                                                  IsActive="@IsActive(nameof(userModel.Email))"
                                                  Required="true"
                                                  Placeholder="adres@example.com" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">NIP</label>
                                <SimpleNipInput Value="@userModel.Nip"
                                                ValueChanged="v => { userModel.Nip = v ?? string.Empty; Touch(nameof(userModel.Nip)); }"
                                                IsActive="@IsActive(nameof(userModel.Nip))"
                                                Placeholder="1234567890" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Numer konta bankowego</label>
                                <SimpleIbanInput Value="@userModel.BankAccountNumber"
                                                 ValueChanged="v => { userModel.BankAccountNumber = v ?? string.Empty; Touch(nameof(userModel.BankAccountNumber)); }"
                                                 IsActive="@IsActive(nameof(userModel.BankAccountNumber))"
                                                 Placeholder="PL..." />
                            </div>

                            <div class="col-12">
                                <hr class="my-4" />
                                <h5 class="text-secondary mb-3">Adres siedziby</h5>
                            </div>

                            <div class="col-md-9">
                                <label class="form-label small fw-bold">Ulica</label>
                                <SimpleTextInput Value="@userModel.Address.Street"
                                                 ValueChanged="v => { userModel.Address.Street = v ?? string.Empty; Touch(nameof(userModel.Address.Street)); }"
                                                 IsActive="@IsActive(nameof(userModel.Address.Street))"
                                                 Placeholder="Ulica" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold">Nr budynku</label>
                                <SimpleTextInput Value="@userModel.Address.Number"
                                                 ValueChanged="v => { userModel.Address.Number = v ?? string.Empty; Touch(nameof(userModel.Address.Number)); }"
                                                 IsActive="@IsActive(nameof(userModel.Address.Number))"
                                                 Placeholder="Nr" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Kod pocztowy</label>
                                <SimplePostalCodeInput Value="@userModel.Address.PostalCode"
                                                       ValueChanged="v => { userModel.Address.PostalCode = v ?? string.Empty; Touch(nameof(userModel.Address.PostalCode)); }"
                                                       IsActive="@IsActive(nameof(userModel.Address.PostalCode))"
                                                       Placeholder="12-345" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-bold">Miasto</label>
                                <SimpleTextInput Value="@userModel.Address.City"
                                                 ValueChanged="v => { userModel.Address.City = v ?? string.Empty; Touch(nameof(userModel.Address.City)); }"
                                                 IsActive="@IsActive(nameof(userModel.Address.City))"
                                                 Placeholder="Miasto" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Kraj</label>
                                <SimpleTextInput Value="@userModel.Address.Country"
                                                 ValueChanged="v => { userModel.Address.Country = v ?? string.Empty; Touch(nameof(userModel.Address.Country)); }"
                                                 IsActive="@IsActive(nameof(userModel.Address.Country))"
                                                 Placeholder="Kraj" />
                            </div>
                        </div>

                        <div class="mt-4 d-flex align-items-center">
                            <button type="button" class="btn btn-success px-4" disabled="@isSubmitting" @onclick="HandleValidSubmit">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Zapisz zmiany
                            </button>
                            @if (!string.IsNullOrEmpty(statusMessage))
                            {
                                <span class="ms-3 alert @statusClass p-2 mb-0">@statusMessage</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h5>Bezpieczeństwo</h5>
                        <p class="text-muted small">Zalecamy regularną zmianę hasła dla ochrony Twoich danych fakturowych.</p>
                        <a href="/change-password" class="btn btn-outline-warning">
                            <i class="bi bi-shield-lock"></i> Zmień hasło dostępu
                        </a>
                    </div>
                </div>

                <div class="card shadow-sm border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">Strefa Niebezpieczna</h5>
                    </div>
                    <div class="card-body p-4">
                        <h5>Usuń konto</h5>
                        <p class="text-muted small">Ta operacja trwale usuwa Twoje konto oraz wszystkie powiązane z nim dane (faktury, klientów, produkty). Tej operacji nie można cofnąć.</p>
                        <button type="button" class="btn btn-danger" @onclick="ShowDeleteModal" disabled="@isSubmitting">
                            <i class="bi bi-trash"></i> Usuń moje konto
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<DeleteAccountModal IsVisible="showDeleteModal"
                    OnClose="() => showDeleteModal = false"
                    OnConfirm="HandleDeleteConfirmed" />

@code {
    private UpdateUserDto? userModel;
    private bool isSubmitting = false;
    private bool showDeleteModal = false;
    private string statusMessage = "";
    private string statusClass = "";
    private HashSet<string> _touched = new();
    private bool _submitAttempted;

    private void Touch(string field) => _touched.Add(field);
    private bool IsActive(string field) => _submitAttempted || _touched.Contains(field);

    private bool IsValid() =>
        userModel != null &&
        !string.IsNullOrWhiteSpace(userModel.Name) &&
        !string.IsNullOrWhiteSpace(userModel.CompanyName) &&
        !string.IsNullOrWhiteSpace(userModel.Email) && EmailFormatHelper.IsValidOrEmpty(userModel.Email) &&
        System.Text.RegularExpressions.Regex.IsMatch(userModel.Nip ?? "", @"^\d{10}$") &&
        System.Text.RegularExpressions.Regex.IsMatch(userModel.BankAccountNumber ?? "", @"^PL\d{26}$") &&
        !string.IsNullOrWhiteSpace(userModel.Address.Street) &&
        !string.IsNullOrWhiteSpace(userModel.Address.Number) &&
        System.Text.RegularExpressions.Regex.IsMatch(userModel.Address.PostalCode ?? "", @"^\d{2}-\d{3}$") &&
        !string.IsNullOrWhiteSpace(userModel.Address.City) &&
        !string.IsNullOrWhiteSpace(userModel.Address.Country);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<GetMeResponse>("api/User/me");

            if (response?.Data != null)
            {
                var userData = response.Data;
                userModel = new UpdateUserDto
                {
                    UserId = userData.UserId,
                    Name = userData.Name,
                    CompanyName = userData.CompanyName,
                    Email = userData.Email,
                    Nip = userData.Nip,
                    BankAccountNumber = userData.BankAccountNumber,
                    Address = new UpdateAddressDto
                    {
                        Street = userData.Address.Street,
                        Number = userData.Address.Number,
                        PostalCode = userData.Address.PostalCode,
                        City = userData.Address.City,
                        Country = userData.Address.Country
                    }
                };

                Touch(nameof(userModel.Name));
                Touch(nameof(userModel.CompanyName));
                Touch(nameof(userModel.Email));
                Touch(nameof(userModel.Nip));
                Touch(nameof(userModel.BankAccountNumber));
                Touch(nameof(userModel.Address.Street));
                Touch(nameof(userModel.Address.Number));
                Touch(nameof(userModel.Address.PostalCode));
                Touch(nameof(userModel.Address.City));
                Touch(nameof(userModel.Address.Country));
            }
        }
        catch (ApiException aex)
        {
            statusMessage = aex.GetUserMessage();
            statusClass = "alert-danger";
            userModel = new UpdateUserDto();
        }
        catch (Exception ex)
        {
            statusMessage = ApiExceptionExtensions.SanitizeMessage(ex.Message);
            statusClass = "alert-danger";
            userModel = new UpdateUserDto();
        }
    }

    private async Task HandleValidSubmit()
    {
        if (userModel == null) return;

        _submitAttempted = true;
        statusMessage = "";
        statusClass = "";

        if (!IsValid())
        {
            statusMessage = "Uzupełnij poprawnie wszystkie wymagane pola.";
            statusClass = "alert-danger";
            return;
        }

        isSubmitting = true;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/User/update/{userModel.UserId}", userModel);
            if (response.IsSuccessStatusCode)
            {
                statusMessage = "Ustawienia zapisane!";
                statusClass = "alert-success";
            }
            else
            {
                var serverMsg = await response.Content.ReadAsStringAsync();

                if (!string.IsNullOrWhiteSpace(serverMsg))
                {
                    try
                    {
                        using var doc = JsonDocument.Parse(serverMsg);
                        var root = doc.RootElement;

                        if (root.TryGetProperty("errors", out var errorsElement) && errorsElement.ValueKind == JsonValueKind.Object)
                        {
                            var sb = new System.Text.StringBuilder();
                            foreach (var prop in errorsElement.EnumerateObject())
                            {
                                foreach (var msgElem in prop.Value.EnumerateArray())
                                {
                                    var raw = msgElem.GetString();
                                    if (!string.IsNullOrWhiteSpace(raw))
                                    {
                                        if (sb.Length > 0) sb.Append(" ; ");
                                        sb.Append(raw);
                                    }
                                }
                            }
                            if (sb.Length > 0)
                            {
                                statusMessage = sb.ToString();
                                statusClass = "alert-danger";
                                return;
                            }
                        }

                        var detail = root.TryGetProperty("detail", out var d) && d.ValueKind == JsonValueKind.String ? d.GetString() : null;
                        var title = root.TryGetProperty("title", out var t) && t.ValueKind == JsonValueKind.String ? t.GetString() : null;
                        var candidate = detail ?? title ?? serverMsg;
                        var sanitized = ApiExceptionExtensions.SanitizeMessage(candidate);
                        if (!sanitized.StartsWith("Błąd"))
                            sanitized = "Błąd: " + sanitized;
                        statusMessage = sanitized;
                        statusClass = "alert-danger";
                        return;
                    }
                    catch
                    {
                        var sanitized = ApiExceptionExtensions.SanitizeMessage(serverMsg);
                        if (!sanitized.StartsWith("Błąd"))
                            sanitized = "Błąd: " + sanitized;
                        statusMessage = sanitized;
                        statusClass = "alert-danger";
                        return;
                    }
                }

                statusMessage = "Błąd podczas zapisu na serwerze.";
                statusClass = "alert-danger";
            }
        }
        catch (ApiException aex)
        {
            var userMessage = aex.GetUserMessage();
            statusMessage = userMessage.StartsWith("Błąd") ? userMessage : $"Błąd: {userMessage}";
            statusClass = "alert-danger";
        }
        catch (Exception ex)
        {
            var sanitized = ApiExceptionExtensions.SanitizeMessage(ex.Message);
            if (!sanitized.StartsWith("Błąd"))
                sanitized = "Błąd: " + sanitized;
            statusMessage = sanitized;
            statusClass = "alert-danger";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ShowDeleteModal()
    {
        showDeleteModal = true;
    }

    private async Task HandleDeleteConfirmed()
    {
        if (userModel == null) return;

        showDeleteModal = false;
        isSubmitting = true;
        statusMessage = "";
        statusClass = "";

        try
        {
            await UserService.DeleteUserAccountAsync(userModel.UserId);
            statusMessage = "Konto zostało usunięte.";
            statusClass = "alert-success";
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "authToken");
            await Task.Delay(300);
            Navigation.NavigateTo("/login");
        }
        catch (ApiException aex)
        {
            var userMessage = aex.GetUserMessage();
            statusMessage = userMessage.StartsWith("Błąd") ? userMessage : $"Błąd: {userMessage}";
            statusClass = "alert-danger";
        }
        catch (Exception ex)
        {
            var sanitized = ApiExceptionExtensions.SanitizeMessage(ex.Message);
            if (!sanitized.StartsWith("Błąd"))
                sanitized = "Błąd: " + sanitized;
            statusMessage = sanitized;
            statusClass = "alert-danger";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}