@page "/forgot-password"
@using System.Text.Json
@using CreateInvoiceSystem.Frontend.Services
@using CreateInvoiceSystem.Frontend.Components
@attribute [AllowAnonymous]
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white py-3">
                    <h3 class="mb-0 text-center">Resetowanie hasła</h3>
                </div>
                <div class="card-body p-4">
                    @if (_isSent)
                    {
                        <div class="text-center p-2">
                            <div class="mb-4">
                                <i class="bi bi-envelope-check text-success" style="font-size: 4rem;"></i>
                            </div>
                            <h3 class="text-success mb-3">Sprawdź e-mail</h3>
                            <div class="alert alert-success shadow-sm">
                                <p class="mb-0 small">
                                    Jeśli podany adres e-mail znajduje się w naszej bazie, wysłaliśmy na niego instrukcję <strong>resetowania hasła</strong>.
                                    Prosimy o sprawdzenie skrzynki e-mail (oraz folderu Spam).
                                </p>
                            </div>
                            <div class="text-center mt-4">
                                <button type="button" class="btn btn-primary btn-lg w-100" @onclick="GoToLogin">
                                    Przejdź do strony logowania
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center mb-4">Wpisz swój adres e-mail, aby otrzymać link do zmiany hasła.</p>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">E-mail</label>
                            <SimpleEmailInput Value="@_email"
                                              ValueChanged="v => { _email = v; Touch(nameof(_email)); }"
                                              IsActive="@IsActive(nameof(_email))"
                                              Required="true"
                                              Placeholder="Twój e-mail" />
                        </div>

                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert-danger small py-2">@_errorMessage</div>
                        }

                        <div class="d-grid gap-2 mt-4">
                            <button type="button" class="btn btn-primary btn-lg" disabled="@_isProcessing" @onclick="HandleSubmit">
                                @if (_isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Wysyłanie...</span>
                                }
                                else
                                {
                                    <span>Wyślij link resetujący</span>
                                }
                            </button>
                        </div>

                        <div class="text-center mt-4">
                            <a href="/login" class="text-decoration-none small text-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Wróć do logowania
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? _email;
    private HashSet<string> _touched = new();
    private bool _submitAttempted;
    private bool _isProcessing;
    private bool _isSent;
    private string? _errorMessage;

    private void Touch(string field) => _touched.Add(field);
    private bool IsActive(string field) => _submitAttempted || _touched.Contains(field);

    private bool IsValid() =>
        !string.IsNullOrWhiteSpace(_email) && EmailFormatHelper.IsValidOrEmpty(_email);

    private async Task HandleSubmit()
    {
        _submitAttempted = true;
        _errorMessage = null;

        if (!IsValid())
        {
            _errorMessage = "Uzupełnij poprawny adres e-mail.";
            return;
        }

        _isProcessing = true;

        try
        {
            var result = await AuthService.ForgotPasswordAsync(_email!);

            if (result?.IsSuccess == true)
            {
                _isSent = true;
                return;
            }

            var resultMessage = result?.Message;
            var sanitized = string.IsNullOrWhiteSpace(resultMessage)
                ? "Wystąpił błąd podczas wysyłki."
                : ApiExceptionExtensions.SanitizeMessage(resultMessage);

            if (!sanitized.StartsWith("Błąd"))
                sanitized = "Błąd: " + sanitized;

            _errorMessage = sanitized;
        }
        catch (ApiException aex)
        {
            var userMessage = aex.GetUserMessage();
            if (!userMessage.StartsWith("Błąd"))
                userMessage = "Błąd: " + userMessage;

            _errorMessage = userMessage;

            if (!string.IsNullOrWhiteSpace(aex.Response))
            {
                try
                {
                    using var doc = JsonDocument.Parse(aex.Response);
                    if (doc.RootElement.TryGetProperty("errors", out var errorsElement) && errorsElement.ValueKind == JsonValueKind.Object)
                    {
                        var sb = new System.Text.StringBuilder();
                        foreach (var prop in errorsElement.EnumerateObject())
                        {
                            foreach (var msgElem in prop.Value.EnumerateArray())
                            {
                                var raw = msgElem.GetString();
                                if (!string.IsNullOrWhiteSpace(raw))
                                {
                                    var sanitizedMsg = ApiExceptionExtensions.SanitizeMessage(raw);
                                    if (!sanitizedMsg.StartsWith("Błąd"))
                                        sanitizedMsg = "Błąd: " + sanitizedMsg;
                                    if (sb.Length > 0) sb.Append(" ; ");
                                    sb.Append(sanitizedMsg);
                                }
                            }
                        }
                        if (sb.Length > 0)
                        {
                            _errorMessage = sb.ToString();
                        }
                    }
                }
                catch
                {
                }
            }
        }
        catch (Exception ex)
        {
            var sanitizedEx = ApiExceptionExtensions.SanitizeMessage(ex.Message);
            if (!sanitizedEx.StartsWith("Błąd"))
                sanitizedEx = "Błąd: " + sanitizedEx;
            _errorMessage = sanitizedEx;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void GoToLogin() => Navigation.NavigateTo("/login");
}