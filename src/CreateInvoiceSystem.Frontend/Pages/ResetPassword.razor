@page "/reset-password"
@using System.Text.Json
@using CreateInvoiceSystem.Frontend.Models
@using Microsoft.AspNetCore.Authorization
@using CreateInvoiceSystem.Frontend.Services
@using CreateInvoiceSystem.Frontend.Components
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject AuthService AuthService

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-sm" style="width: 100%; max-width: 400px;">
        <div class="card-body p-4">
            <h3 class="card-title text-center mb-4">Ustaw nowe hasło</h3>

            @if (_isSuccess)
            {
                <div class="alert alert-success">Hasło zostało zmienione.</div>
                <button class="btn btn-primary w-100" @onclick='(() => Navigation.NavigateTo("/login"))'>Zaloguj się</button>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label small fw-bold">Nowe hasło</label>
                    <SimplePasswordInput Value="@_password"
                                         ValueChanged="v => { _password = v ?? string.Empty; Touch(nameof(_password)); }"
                                         IsActive="@IsActive(nameof(_password))"
                                         MinLength="6" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Powtórz hasło</label>
                    <SimplePasswordInput Value="@_confirmPassword"
                                         ValueChanged="v => { _confirmPassword = v ?? string.Empty; Touch(nameof(_confirmPassword)); }"
                                         IsActive="@IsActive(nameof(_confirmPassword))"
                                         MinLength="0"
                                         CompareTo="@_password" />
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger small">@_errorMessage</div>
                }

                <button type="button" class="btn btn-success w-100" disabled="@_isProcessing" @onclick="HandleReset">
                    @if (_isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Zmień hasło
                </button>
            }
        </div>
    </div>
</div>

@code {
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isProcessing;
    private bool _isSuccess;
    private string? _errorMessage;
    private HashSet<string> _touched = new();
    private bool _submitAttempted;

    [Parameter][SupplyParameterFromQuery] public string? Token { get; set; }
    [Parameter][SupplyParameterFromQuery] public string? Email { get; set; }
    [Parameter][SupplyParameterFromQuery] public string? Version { get; set; }

    private void Touch(string field) => _touched.Add(field);
    private bool IsActive(string field) => _submitAttempted || _touched.Contains(field);

    private bool IsValid() =>
        !string.IsNullOrWhiteSpace(_password) &&
        _password.Length >= 6 &&
        _password == _confirmPassword;

    private string FormatErrorMessage(string? rawMessage)
    {
        if (string.IsNullOrWhiteSpace(rawMessage))
            return "Błąd: Wystąpił nieoczekiwany problem.";

        string msgToParse = rawMessage.Trim();

        if (msgToParse.StartsWith("Błąd:"))
        {
            msgToParse = msgToParse.Substring(5).Trim();
        }

        try
        {
            if (msgToParse.StartsWith("{") && msgToParse.EndsWith("}"))
            {
                using var doc = JsonDocument.Parse(msgToParse);
                if (doc.RootElement.TryGetProperty("message", out var msgProp))
                {
                    return $"Błąd: {msgProp.GetString()}";
                }
            }
        }
        catch
        {
        }

        var sanitized = ApiExceptionExtensions.SanitizeMessage(rawMessage);
        return sanitized.StartsWith("Błąd") ? sanitized : $"Błąd: {sanitized}";
    }

    private async Task HandleReset()
    {
        _submitAttempted = true;
        _errorMessage = null;

        if (!IsValid())
        {
            _errorMessage = "Uzupełnij poprawnie oba pola hasła.";
            return;
        }

        if (string.IsNullOrEmpty(Token) || string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Version))
        {
            _errorMessage = "Brak tokena, adresu email lub wersji resetu.";
            return;
        }

        _isProcessing = true;

        try
        {
            var result = await AuthService.ResetPasswordAsync(Email, Token, Version, _password);

            if (result != null && result.IsSuccess)
            {
                _isSuccess = true;
                return;
            }

            _errorMessage = FormatErrorMessage(result?.Message);
        }
        catch (ApiException aex)
        {
            _errorMessage = FormatErrorMessage(aex.Response ?? aex.GetUserMessage());
        }
        catch (Exception ex)
        {
            _errorMessage = FormatErrorMessage(ex.Message);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }
}
}