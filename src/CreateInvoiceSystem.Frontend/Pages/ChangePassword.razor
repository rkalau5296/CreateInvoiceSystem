@page "/change-password"
@using System.Text.Json
@using CreateInvoiceSystem.Frontend.Models
@using CreateInvoiceSystem.Frontend.Components
@using CreateInvoiceSystem.Frontend.Services
@inject HttpClient Http

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 text-center">Zmiana hasła</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Obecne hasło</label>
                        <SimplePasswordInput Value="@_oldPassword"
                                             ValueChanged="v => { _oldPassword = v ?? string.Empty; Touch(nameof(_oldPassword)); }"
                                             IsActive="@IsActive(nameof(_oldPassword))"
                                             MinLength="0"
                                             Placeholder="Wprowadź obecne hasło" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Nowe hasło</label>
                        <SimplePasswordInput Value="@_newPassword"
                                             ValueChanged="v => { _newPassword = v ?? string.Empty; Touch(nameof(_newPassword)); }"
                                             IsActive="@IsActive(nameof(_newPassword))"
                                             MinLength="6"
                                             RequireComplexity="true"
                                             Placeholder="Wprowadź nowe hasło" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold">Potwierdź nowe hasło</label>
                        <SimplePasswordInput Value="@_confirmPassword"
                                             ValueChanged="v => { _confirmPassword = v ?? string.Empty; Touch(nameof(_confirmPassword)); }"
                                             IsActive="@IsActive(nameof(_confirmPassword))"
                                             MinLength="0"
                                             CompareTo="@_newPassword"
                                             Placeholder="Powtórz nowe hasło" />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-primary btn-lg" disabled="@isSubmitting" @onclick="OnSubmit">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span class="ms-2">Przetwarzanie...</span>
                            }
                            else
                            {
                                <span>Zapisz zmiany</span>
                            }
                        </button>
                        <a href="/settings" class="btn btn-link text-center text-decoration-none small text-secondary">Wróć do ustawień</a>
                    </div>

                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert mt-4 py-2 small @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
                            @message
                            <button type="button" class="btn-close" @onclick="() => message = string.Empty"></button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _oldPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string message = "";
    private bool isError = false;
    private bool isSubmitting = false;
    private HashSet<string> _touched = new();
    private bool _submitAttempted;

    private void Touch(string field) => _touched.Add(field);
    private bool IsActive(string field) => _submitAttempted || _touched.Contains(field);

    private static readonly System.Text.RegularExpressions.Regex PasswordComplexity =
        new(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).{6,}$");

    private bool IsValid() =>
        !string.IsNullOrWhiteSpace(_oldPassword) &&
        !string.IsNullOrWhiteSpace(_newPassword) &&
        PasswordComplexity.IsMatch(_newPassword) &&
        _newPassword == _confirmPassword;

    private async Task OnSubmit()
    {
        _submitAttempted = true;
        message = "";
        isError = false;

        if (!IsValid())
        {
            message = "Uzupełnij poprawnie wszystkie pola.";
            isError = true;
            return;
        }

        isSubmitting = true;

        var dto = new ChangePasswordDto(_oldPassword, _newPassword, _confirmPassword);
        var request = new ChangePasswordRequest(dto);

        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/change-password", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ChangePasswordResponse>();

                if (result != null && result.IsSuccess)
                {
                    message = "Hasło zostało pomyślnie zmienione.";
                    isError = false;

                    _oldPassword = string.Empty;
                    _newPassword = string.Empty;
                    _confirmPassword = string.Empty;
                    _touched.Clear();
                    _submitAttempted = false;
                    StateHasChanged();
                    return;
                }

                var svcMsg = result?.Message;
                var sanitized = string.IsNullOrWhiteSpace(svcMsg)
                    ? "Wystąpił błąd podczas zmiany hasła."
                    : ApiExceptionExtensions.SanitizeMessage(svcMsg);

                if (!sanitized.StartsWith("Błąd"))
                    sanitized = "Błąd: " + sanitized;

                message = sanitized;
                isError = true;
                return;
            }

            var serverMsg = await response.Content.ReadAsStringAsync();

            if (!string.IsNullOrWhiteSpace(serverMsg))
            {
                try
                {
                    using var doc = JsonDocument.Parse(serverMsg);
                    var root = doc.RootElement;

                    if (root.TryGetProperty("errors", out var errorsElement) && errorsElement.ValueKind == JsonValueKind.Object)
                    {
                        var sb = new System.Text.StringBuilder();
                        foreach (var prop in errorsElement.EnumerateObject())
                        {
                            foreach (var msgElem in prop.Value.EnumerateArray())
                            {
                                var raw = msgElem.GetString();
                                if (!string.IsNullOrWhiteSpace(raw))
                                {
                                    var sanitizedMsg = ApiExceptionExtensions.SanitizeMessage(raw);
                                    if (!sanitizedMsg.StartsWith("Błąd"))
                                        sanitizedMsg = "Błąd: " + sanitizedMsg;
                                    if (sb.Length > 0) sb.Append(" ; ");
                                    sb.Append(sanitizedMsg);
                                }
                            }
                        }
                        if (sb.Length > 0)
                        {
                            message = sb.ToString();
                            isError = true;
                            return;
                        }
                    }

                    var detail = root.TryGetProperty("detail", out var d) && d.ValueKind == JsonValueKind.String ? d.GetString() : null;
                    var title = root.TryGetProperty("title", out var t) && t.ValueKind == JsonValueKind.String ? t.GetString() : null;
                    var candidate = detail ?? title ?? serverMsg;
                    var sanitized = ApiExceptionExtensions.SanitizeMessage(candidate);
                    if (!sanitized.StartsWith("Błąd"))
                        sanitized = "Błąd: " + sanitized;
                    message = sanitized;
                    isError = true;
                    return;
                }
                catch
                {
                    var sanitized = ApiExceptionExtensions.SanitizeMessage(serverMsg);
                    if (!sanitized.StartsWith("Błąd"))
                        sanitized = "Błąd: " + sanitized;
                    message = sanitized;
                    isError = true;
                    return;
                }
            }

            message = $"Błąd serwera: {response.StatusCode}";
            isError = true;
        }
        catch (ApiException aex)
        {
            var userMessage = aex.GetUserMessage();
            if (!userMessage.StartsWith("Błąd"))
                userMessage = "Błąd: " + userMessage;
            message = userMessage;
            isError = true;
        }
        catch (Exception ex)
        {
            var sanitizedEx = ApiExceptionExtensions.SanitizeMessage(ex.Message);
            if (!sanitizedEx.StartsWith("Błąd"))
                sanitizedEx = "Błąd: " + sanitizedEx;
            message = sanitizedEx;
            isError = true;
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}