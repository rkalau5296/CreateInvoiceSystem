@namespace CreateInvoiceSystem.Frontend.Components

<input list="@DataList"
       type="text"
       class="@CssClass"
       value="@Value"
       placeholder="@Placeholder"
       @oninput="OnInput" />

@if (ShowError)
{
    <span class="text-danger small">@ActualErrorMessage</span>
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? DataList { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public string ErrorMessage { get; set; } = "Nieprawidłowy format adresu email";

    private bool IsEmpty => string.IsNullOrWhiteSpace(Value);
    private bool IsInvalid => (Required && IsEmpty) || !EmailFormatHelper.IsValidOrEmpty(Value);
    private bool ShowError => IsActive && IsInvalid;
    private string ActualErrorMessage => Required && IsEmpty ? "Email jest wymagany" : ErrorMessage;

    private string CssClass =>
        !IsActive ? "form-control" :
        IsInvalid ? "form-control is-invalid" : "form-control is-valid";

    private async Task OnInput(ChangeEventArgs e)
    {
        await ValueChanged.InvokeAsync(e.Value?.ToString());
    }
}