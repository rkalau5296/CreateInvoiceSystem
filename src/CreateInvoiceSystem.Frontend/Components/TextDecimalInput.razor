@namespace CreateInvoiceSystem.Frontend.Components
@using System.Globalization

@if (!string.IsNullOrEmpty(Label))
{
    <label class="form-label">
        @Label
        @if (Required)
        {
            <span class="text-danger ms-1" title="Pole wymagane">*</span>
        }
    </label>
}
<input type="text"
       inputmode="decimal"
       class="@CssClass"
       value="@Value?.ToString(CultureInfo.InvariantCulture)"
       placeholder="@Placeholder"
       @oninput="OnInput"
       @onblur="OnBlur"
       autocomplete="off" />

@if (ShowError)
{
    <span class="text-danger small">@ErrorMessage</span>
}

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public decimal? Value { get; set; }
    [Parameter] public EventCallback<decimal?> ValueChanged { get; set; }
    [Parameter] public bool Touched { get; set; }
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public string ErrorMessage { get; set; } = "Pole jest wymagane";

    private bool IsInvalid =>
        !Value.HasValue || Value <= 0 || Value.Value % 1 != 0 &&
        decimal.Round(Value.Value, 2) != Value.Value;

    private bool ShowError => Touched && IsInvalid;

    private string CssClass =>
        !Touched ? "form-control" :
        IsInvalid ? "form-control is-invalid" : "form-control is-valid";

    private async Task OnInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;

        raw = raw.Trim().Replace(',', '.');

        if (decimal.TryParse(
                raw,
                NumberStyles.AllowDecimalPoint |
                NumberStyles.AllowLeadingSign,
                CultureInfo.InvariantCulture,
                out var value))
        {
            await ValueChanged.InvokeAsync(value);
        }
        else
        {
            await ValueChanged.InvokeAsync(null);
        }
    }

    private async Task OnBlur(FocusEventArgs _)
    {
        if (Value.HasValue)
        {
            await ValueChanged.InvokeAsync(
                decimal.Round(Value.Value, 2));
        }
    }
}