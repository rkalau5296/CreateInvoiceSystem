@namespace CreateInvoiceSystem.Frontend.Components

<input type="password"
       class="@CssClass"
       value="@Value"
       placeholder="@Placeholder"
       @oninput="OnInput" />

@if (ShowError)
{
    <span class="text-danger small">@ActualErrorMessage</span>
}

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public int MinLength { get; set; } = 6;
    [Parameter] public bool RequireComplexity { get; set; } = false;
    [Parameter] public string? CompareTo { get; set; }

    private bool IsEmpty => string.IsNullOrWhiteSpace(Value);
    private bool IsTooShort => !IsEmpty && Value!.Length < MinLength;
    private bool FailsComplexity => RequireComplexity && !IsEmpty &&
        !System.Text.RegularExpressions.Regex.IsMatch(Value!, @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).+$");
    private bool DoesNotMatch => CompareTo != null && Value != CompareTo;

    private bool IsInvalid => IsEmpty || IsTooShort || FailsComplexity || DoesNotMatch;
    private bool ShowError => IsActive && IsInvalid;

    private string ActualErrorMessage =>
        IsEmpty ? "Hasło jest wymagane" :
        IsTooShort ? $"Hasło musi mieć co najmniej {MinLength} znaków" :
        FailsComplexity ? "Hasło musi zawierać małe i duże litery, cyfrę oraz znak specjalny" :
        DoesNotMatch ? "Hasła muszą być takie same" :
        string.Empty;

    private string CssClass =>
        !IsActive ? "form-control" :
        IsInvalid ? "form-control is-invalid" : "form-control is-valid";

    private async Task OnInput(ChangeEventArgs e)
    {
        await ValueChanged.InvokeAsync(e.Value?.ToString());
    }
}